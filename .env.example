# Supabase Configuration
# Replace with your Supabase Project URL and API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Scraper Configuration
# API key for the external web scraping service
SCRAPER_API_KEY=your-scraper-api-key

# Valkey / Redis URL (BullMQ Queue Store)
# Local development default: redis://127.0.0.1:6379
REDIS_URL=redis://default:password@localhost:6379

# LLM Providers API Keys
# DeepSeek API Key for Job Evaluation/Analysis
DEEPSEEK_API_KEY=your-deepseek-api-key
# OpenAI API Key for Resume Embedding Vector Generation
OPENAI_API_KEY=your-openai-api-key

# LLM Scorer Similarity Boundaries
# Values used to normalize cosine similarity match scores
SIMILARITY_MIN_BOUND=0.3
SIMILARITY_MAX_BOUND=0.7
